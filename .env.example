# ==============================================================================
# AUTOPSY.AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or backend/.env and populate with your credentials.
# ==============================================================================

# --- AI & LLM PROVIDER KEYS ---
# Primary Google Gemini API Key for Grounded Claim Extraction & Fallback Reasoning
GEMINI_API_KEY="AIzaSy..."

# OpenRouter API Key for Multi-Model Routing (GPT-4o-mini, Claude, DeepSeek, etc.)
OPENROUTER_API_KEY="sk-or-v1-..."

# Direct OpenAI API Key (Optional fallback)
OPENAI_API_KEY="sk-proj-..."

# Model Selection Defaults
EXTRACTOR_MODEL="gemini-3.5-flash-lite"
REASONER_MODEL="openai/gpt-4o-mini"

# --- LIVE RETRIEVAL & SEARCH ENGINES ---
# Tavily Search API Key (Primary live search for policy archives and news)
TAVILY_API_KEY="tvly-..."

# Optional SerpApi or Google Custom Search
SERPAPI_API_KEY=""
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""

# --- DATABASE PERSISTENCE (POSTGRESQL / SQLITE) ---
# Default SQLite is used if PostgreSQL credentials are left blank.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="autopsy_db"
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/autopsy_db"

# --- SYSTEM & ENVIRONMENT SETTINGS ---
USE_SSL="false"
ENVIRONMENT="development"

# Vector Search (Optional Qdrant cluster)
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
