# ==============================================================================
# AUTOPSY.AI — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to frontend/.env.local and adjust if required.
# Note: In development, Next.js rewrites proxy /api requests directly to http://127.0.0.1:8008.
# ==============================================================================

# Backend API Base URL (if overriding proxy rewrites)
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8008"

# WebSocket Endpoint for real-time investigation streaming
NEXT_PUBLIC_WS_BASE_URL="ws://127.0.0.1:8008"

# Optional Clerk Authentication (if enabled)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
