# ==============================================================================
# AUTOPSY.AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env and populate with your credentials.
# ==============================================================================

# --- AI & LLM PROVIDER KEYS ---
GEMINI_API_KEY="AIzaSy..."
OPENROUTER_API_KEY="sk-or-v1-..."
OPENAI_API_KEY="sk-proj-..."

# Dual Model Orchestration
EXTRACTOR_MODEL="gemini-3.5-flash-lite"
REASONER_MODEL="openai/gpt-4o-mini"

# --- LIVE RETRIEVAL & SEARCH ENGINES ---
TAVILY_API_KEY="tvly-..."
SERPAPI_API_KEY=""
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""

# --- DATABASE CONFIGURATION ---
# PostgreSQL (Optional - system falls back to SQLite autopsy_dpr.db automatically)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="autopsy_db"
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/autopsy_db"

# --- SYSTEM & ENVIRONMENT SETTINGS ---
USE_SSL="false"
ENVIRONMENT="development"

# Vector Search (Optional Qdrant cluster)
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
